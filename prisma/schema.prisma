generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* -------------------- ENUMS -------------------- */

enum GroupRole {
  OWNER
  MEMBER
}

enum SplitType {
  EVEN
  EXACT
  PERCENTAGE
  SHARES
}

enum SettlementStatus {
  PENDING
  COMPLETED
  REJECTED
}

/* -------------------- MODELS -------------------- */

// User model for authentication
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  name         String
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime?

  // Relations
  createdGroups Group[]       @relation("GroupCreator")
  memberships   GroupMember[]

  @@map("users")
}

/* -------------------- GROUP -------------------- */

model Group {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique @map("invite_code")
  currency   String   @default("USD")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime?

  // Relations
  creator  User          @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members  GroupMember[]
  expenses Expense[]
  settlements Settlement[]
  memberBalances MemberBalance[]
  debts          Debt[]

  @@index([inviteCode])
  @@map("groups")
}

/* -------------------- MEMBER BALANCE -------------------- */

model MemberBalance {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  memberId  String   @map("member_id")
  balance   Decimal  @db.Decimal(18, 6) @default(0)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt @map("updated_at")

  group  Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId, currency])
  @@map("member_balances")
}

/* -------------------- DEBT -------------------- */

model Debt {
  id         String   @id @default(uuid())
  groupId    String   @map("group_id")
  debtorId   String   @map("debtor_id")
  creditorId String   @map("creditor_id")
  amount     Decimal  @db.Decimal(18, 6) @default(0)
  currency   String   @default("USD")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group    Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  debtor   GroupMember @relation("DebtDebtor", fields: [debtorId], references: [id], onDelete: Cascade)
  creditor GroupMember @relation("DebtCreditor", fields: [creditorId], references: [id], onDelete: Cascade)

  @@unique([groupId, debtorId, creditorId, currency])
  @@map("debts")
}

/* -------------------- GROUP MEMBER -------------------- */

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String?  @map("user_id")
  name      String
  avatarUrl String?  @map("avatar_url")
  role      GroupRole @default(MEMBER)
  isGuest   Boolean  @default(false) @map("is_guest")
  joinedAt  DateTime @default(now()) @map("joined_at")
  deletedAt DateTime?

  // Relations
  group            Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  paidExpenses     ExpensePayer[]
  expenseSplits    ExpenseSplit[]
  settlementsFrom  Settlement[]    @relation("SettlementFrom")
  settlementsTo    Settlement[]    @relation("SettlementTo")
  memberBalances   MemberBalance[]
  debtsAsDebtor    Debt[]          @relation("DebtDebtor")
  debtsAsCreditor  Debt[]          @relation("DebtCreditor")

  @@unique([groupId, userId])
  @@index([groupId])
  @@map("group_members")
}

/* -------------------- EXPENSE -------------------- */

model Expense {
  id           String   @id @default(uuid())
  groupId      String   @map("group_id")
  description  String
  amount       Decimal  @db.Decimal(18, 6)
  roundingDiff Decimal  @default(0) @db.Decimal(18, 6) @map("rounding_diff")
  splitType    SplitType @map("split_type")
  currency     String   @default("USD")
  exchangeRate Decimal? @db.Decimal(18, 6) @map("exchange_rate") // to group currency
  date         DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  group    Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payers   ExpensePayer[]
  splits   ExpenseSplit[]

  @@index([groupId])
  @@map("expenses")
}

/* -------------------- EXPENSE PAYER -------------------- */

model ExpensePayer {
  id        String  @id @default(uuid())
  expenseId String  @map("expense_id")
  memberId  String  @map("member_id")
  amount    Decimal @db.Decimal(18, 6)

  // Relations
  expense Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  GroupMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@map("expense_payers")
}

/* -------------------- EXPENSE SPLIT -------------------- */

model ExpenseSplit {
  id         String  @id @default(uuid())
  expenseId  String  @map("expense_id")
  memberId   String  @map("member_id")
  amount     Decimal @db.Decimal(18, 6)
  share      Decimal? @db.Decimal(18, 6) // For SHARES split type
  percentage Decimal? @db.Decimal(18, 6) // For PERCENTAGE split type

  // Relations
  expense Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  GroupMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@index([memberId])
  @@map("expense_splits")
}

/* -------------------- SETTLEMENTS -------------------- */

model Settlement {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  amount    Decimal  @db.Decimal(18, 6)
  currency  String   @default("USD")
  status    SettlementStatus @default(PENDING)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  group Group @relation(fields: [groupId], references: [id])
  from  GroupMember @relation("SettlementFrom", fields: [fromId], references: [id])
  to    GroupMember @relation("SettlementTo", fields: [toId], references: [id])

  @@index([groupId])
  @@index([fromId])
  @@index([toId])
  @@map("settlements")
}

/* -------------------- IDEMPOTENCY -------------------- */

// Claims a client-supplied Idempotency-Key so a retried or double-submitted
// request (network timeout, double-click) replays the original response
// instead of re-executing the mutation. statusCode 0 means "claimed, still
// in flight" - a genuine value is written once the wrapped operation
// completes.
model IdempotencyKey {
  key          String   @id
  userId       String   @map("user_id")
  endpoint     String
  statusCode   Int      @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}
